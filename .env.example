POLYMETL_RPC_URL=https://1rpc.io/matic 
#https://polygon-rpc.com
POLYMETL_CLICKHOUSE_HOST=localhost
POLYMETL_CLICKHOUSE_PORT=9000
POLYMETL_CLICKHOUSE_USER=poly
# Required by Docker Compose. Generate with: openssl rand -hex 32
# POLYMETL_CLICKHOUSE_PASSWORD=
POLYMETL_CLICKHOUSE_DATABASE=polymetl
POLYMETL_CHAIN_ID=137
# 可选：只抓取某个合约地址的事件
# POLYMETL_EXCHANGE_ADDRESS=0x...
# 可选：初始/结束区块
# POLYMETL_START_BLOCK=49200000
# POLYMETL_END_BLOCK=49300000
POLYMETL_LOG_BATCH_SIZE=2000
POLYMETL_INSERT_BATCH_SIZE=5000

# Required when running the backend with NODE_ENV=production.
# Generate with: openssl rand -hex 32
# POLY_API_TOKEN=
# Required by Docker Compose for stable stored API-key encryption.
# Generate with: openssl rand -hex 32
# POLY_SECRET=
# Optional read-only bearer token for API clients (must also be 32+ characters).
# POLY_API_READ_TOKEN=
# Structured backend log level: fatal, error, warn, info, debug, trace, silent.
POLY_LOG_LEVEL=info

# Experiment resource limits (server-authoritative; the web UI discovers these).
POLY_MAX_EXPERIMENT_AGENTS=100
POLY_MAX_EXPERIMENT_TICKS=200
POLY_MAX_ACTIVE_RUNS=2
# Durable event/checkpoint bounds. Byte values are positive integers.
POLY_EVENT_LOG_MAX_BYTES=67108864
POLY_EVENT_LOG_MAX_PENDING_BYTES=4194304
POLY_EVENT_LOG_RETENTION_DAYS=30
POLY_CHECKPOINT_MAX_BYTES=134217728
POLY_CHECKPOINT_RETENTION_DAYS=30
# JSON replay is cursor-paginated; the server caps every response.
POLY_REPLAY_DEFAULT_LIMIT=1000
POLY_REPLAY_MAX_LIMIT=5000

# DeepSeek agent simulation (src/agent.py)
POLYMETL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
POLYMETL_DEEPSEEK_MODEL=deepseek-v4-flash
# POLYMETL_DEEPSEEK_API_KEY=sk-...   # set in your local .env, never commit

# Optional Langfuse Prompt Management. Local versioned prompts are always the
# fallback. Install the client with: uv sync --extra prompt-management
POLYMETL_LANGFUSE_PROMPT_MANAGEMENT_ENABLED=false
# POLYMETL_LANGFUSE_PUBLIC_KEY=pk-lf-...
# POLYMETL_LANGFUSE_SECRET_KEY=sk-lf-...
POLYMETL_LANGFUSE_BASE_URL=https://cloud.langfuse.com
POLYMETL_LANGFUSE_PROMPT_LABEL=production
POLYMETL_LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300

# Optional: exact HTTP(S) origins allowed for private/insecure custom LLM endpoints.
# Public custom endpoints must use HTTPS and resolve only to public IP addresses.
# POLY_LLM_ENDPOINT_ALLOWLIST=http://host.docker.internal:11434
